# Runtime image
THISM_IMAGE=ghcr.io/jsllxx77/thism:latest

# Published host port
THISM_PORT=8080

# Host-side Docker secret files. install-compose.sh creates these with
# random values and keeps the actual credentials out of .env.
THISM_TOKEN_SECRET_FILE=./secrets/thism_token
THISM_ADMIN_USER_SECRET_FILE=./secrets/thism_admin_user
THISM_ADMIN_PASS_SECRET_FILE=./secrets/thism_admin_pass

# Writable offline GeoIP directory. install-compose.sh prepares it for the image user.
# THISM_GEOIP_HOST_DIR=/var/lib/thism/geo
# THISM_GEOIP_DIR=/geo
